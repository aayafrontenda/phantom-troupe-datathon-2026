# Скопируйте в .env и поправьте. deploy/run_server.* читают этот файл.

# --- сервис ---
ANALYZER=mock                 # mock — без модели (Mac), ml — настоящий пайплайн (ROG)
API_KEY=                      # пусто = сгенерируется и сохранится в storage/api_key.txt
UI_REQUIRE_KEY=0              # 1 — интерфейс тоже спрашивает ключ
MAX_UPLOAD_MB=200
VIDEO_TTL_SEC=3600            # видео удаляются через час после обработки
JOB_HARD_LIMIT_SEC=280        # от загрузки; пайплайн сам сокращает проверки, если не успевает
CORS_ORIGINS=*
WARMUP=1                      # загрузить модели при старте
MOCK_DELAY=3

# --- модель ---
SAMPLE_FPS=2
DETECTOR_MODEL=PekingU/rtdetr_r18vd
DETECTOR_DEVICE=auto          # auto|cuda|mps|cpu
DET_SCORE=0.45
VLM_BACKEND=ollama            # ollama | openai | none
VLM_URL=http://127.0.0.1:11434
VLM_MODEL=qwen2.5vl:7b
VLM_TIMEOUT=60
VLM_IMAGE_SIDE=448
VLM_FRAMES_PER_CALL=5
VLM_WINDOW_SEC=6
MAX_VLM_CALLS=12
MIN_CONFIDENCE=0.5
MERGE_SEC=5
TIME_BUDGET_SEC=120
SCREEN_ON_V=140
# HF_HUB_OFFLINE=1            # включить после того, как веса скачаны
