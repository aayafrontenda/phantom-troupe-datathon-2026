# Copy to .env and edit. Loaded by the service itself (process env wins over this file) and by docker compose.
# Keep comments on their own lines: docker compose reads `KEY=   # text` as the value "# text".

# --- service ---
# mock - no model (no GPU); ml - real pipeline (GPU); module:function - custom
ANALYZER=mock
# process - analyzer in an isolated child process (recommended); thread - in-process
WORKER_MODE=process
# one GPU -> one worker (each worker loads the models)
WORKERS=1
# load detector / ping VLM in the worker at start
WARMUP=1
# jury key; empty = generated once into storage/api_key.txt
API_KEY=
# admin key (cameras, keys, config); empty = same as API_KEY
ADMIN_KEY=
# 1 - the web UI requires sign-in (operator / supervisor / admin); 0 - open UI as admin (development only)
AUTH_REQUIRED=1
# first-start users: login:password:role:name;...  (roles: operator | supervisor | admin). Change passwords in the UI later.
SEED_USERS=admin:admin:admin:Administrator;operator:operator:operator:Operator;supervisor:supervisor:supervisor:Supervisor
# session lifetime in seconds
SESSION_TTL_SEC=604800
# uploads per minute per key / IP
RATE_LIMIT_PER_MIN=60
MAX_UPLOAD_MB=200
# jury uploads (POST /api/v1/analyze) are deleted this long after the check - the brief forbids keeping them
JURY_VIDEO_TTL_SEC=3600
# operator uploads and camera clips are kept this many days; 0 = forever
VIDEO_RETENTION_DAYS=0
# 0 = keep results (JSON with frames) forever
RESULT_TTL_SEC=0
# identical file (SHA-256) + same analyzer -> instant result
DEDUP=1
# cut a 10-second mp4 around every violation (needs ffmpeg on PATH)
MAKE_CLIPS=1
CORS_ORIGINS=*
# Hostnames that serve only the API (no UI): / returns the API index, UI routes return 404
API_HOSTS=pt-dt-26-api.drdieb.com
# e.g. https://xxx.trycloudflare.com - used in alert links
PUBLIC_URL=
LOG_LEVEL=INFO
LOG_JSON=0
MOCK_DELAY=3

# --- deadlines (the jury waits 300 s from the start of the upload) ---
# soft deadline passed to the pipeline, counted from the start of the upload
JOB_HARD_LIMIT_SEC=270
# after soft deadline + grace the worker is killed and a partial result is returned
WATCHDOG_GRACE_SEC=8
# no progress for this long -> worker killed, partial result returned
WORKER_STALL_SEC=150
# with several videos queued, each job's time is shared with the ones behind it; never less than this
MIN_JOB_BUDGET_SEC=35
# partial - done with what was found so far; failed - status=failed
ON_DEADLINE=partial
# analyzer exception after retries: partial | failed
ON_FAILURE=partial
# crash / exception -> one retry if there is still time
MAX_ATTEMPTS=2
RETRY_ON_ERROR=1

# --- live mode ---
# frames per second analyzed per camera / browser session
LIVE_FPS=4
# ...while jury/UI jobs are being processed
LIVE_FPS_BUSY=1
LIVE_MAX_SIDE=640
# camera alerts become findings with a clip: seconds before / after the alert kept in the clip
LIVE_FINDINGS=1
CAMERA_CLIP_PRE_SEC=8
CAMERA_CLIP_POST_SEC=4
CAMERA_RECONNECT_SEC=5

# --- alerts (all optional; policy in backend/alerts.yaml) ---
# Telegram bot from @BotFather. Users link their own Telegram in the UI (profile menu -> Telegram).
# Notifications only: operators get possible violations, supervisors get findings an operator rejected; decisions stay on the site.
TELEGRAM_BOT_TOKEN=
# optional shared group chats (broadcast)
TELEGRAM_CHAT_OPERATOR=
TELEGRAM_CHAT_SUPERVISOR=
# only the server that polls receives button presses and /commands; Docker sets 1, local dev servers 0
TELEGRAM_POLL=0
# 0 = text only: no frames leave the server
TELEGRAM_PHOTOS=1
# SIEM / SOC endpoint, JSON POST signed with X-Signature (HMAC-SHA256)
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_OPERATOR=
ALERT_EMAIL_SUPERVISOR=

# --- model (read by ml/) ---
SAMPLE_FPS=2
DETECTOR_MODEL=PekingU/rtdetr_r18vd
# auto|cuda|mps|cpu
DETECTOR_DEVICE=auto
DET_SCORE=0.45
# ollama | openai | none
VLM_BACKEND=ollama
VLM_URL=http://127.0.0.1:11434
# Qwen3.5-4B (Apache-2.0, ~3.3 ГБ): ollama pull qwen3.5:4b
VLM_MODEL=qwen3.5:4b
VLM_TIMEOUT=60
VLM_IMAGE_SIDE=448
VLM_FRAMES_PER_CALL=5
VLM_WINDOW_SEC=6
# workplace scan: VLM questions per video (the main pass)
DESK_MAX_CALLS=26
# legacy generic checklist pass (VLM_GENERIC=1 only); off by default
MAX_VLM_CALLS=12
MIN_CONFIDENCE=0.5
MERGE_SEC=5
# own budget per video, s: enough for the longest single video (desk scan + desk objects + T12); the service
# shortens it further when the queue is deep (MIN_JOB_BUDGET_SEC), worst case 90 + 4 x 45 s fits the 300 s limit
TIME_BUDGET_SEC=90
SCREEN_ON_V=140
# enable once the weights are downloaded
# HF_HUB_OFFLINE=1

# --- docker (docker-compose.yml / docker-compose.gpu.yml, see deploy/DOCKER.md) ---
# host port of the web UI and API
PORT=8000
# analyzer inside the container: empty = mock for docker-compose.yml, ml with docker-compose.gpu.yml
ANALYZER_DOCKER=
# VLM for the GPU stack: empty = the bundled ollama service; http://host.docker.internal:11434 = Ollama on the host
VLM_URL_DOCKER=
# named Cloudflare tunnel (profile tunnel-named); empty = use the quick tunnel (profile tunnel)
CLOUDFLARE_TUNNEL_TOKEN=

# AI quality: per-type confidence thresholds are raised from verified decisions when a type is confirmed
# less often than QUALITY_TARGET_PRECISION over at least QUALITY_MIN_SAMPLES decisions (nothing is hidden: such alerts become "low")
QUALITY_MIN_SAMPLES=10
QUALITY_TARGET_PRECISION=0.75
