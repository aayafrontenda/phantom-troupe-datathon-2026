# Copy to .env and edit. Loaded by the service itself (process env wins over this file).

# --- service ---
ANALYZER=mock                 # mock — no model (Mac); ml — real pipeline (ROG); module:function — custom
WORKER_MODE=process           # process — analyzer in an isolated child process (recommended); thread — in-process
WORKERS=1                     # one GPU -> one worker (each worker loads the models)
WARMUP=1                      # load detector / ping VLM in the worker at start
API_KEY=                      # jury key; empty = generated once into storage/api_key.txt
ADMIN_KEY=                    # admin key (cameras, keys, config); empty = same as API_KEY
UI_REQUIRE_KEY=0              # 1 — the web UI endpoints also require a key
RATE_LIMIT_PER_MIN=60         # uploads per minute per key / IP
MAX_UPLOAD_MB=200
VIDEO_TTL_SEC=3600            # uploaded videos and clips are deleted this long after the job finishes
RESULT_TTL_SEC=0              # 0 = keep results (JSON with frames) forever
DEDUP=1                       # identical file (SHA-256) + same analyzer -> instant result
MAKE_CLIPS=1                  # cut a 10-second mp4 around every violation (needs ffmpeg on PATH)
CORS_ORIGINS=*
PUBLIC_URL=                   # e.g. https://xxx.trycloudflare.com — used in alert links
LOG_LEVEL=INFO
LOG_JSON=0
MOCK_DELAY=3

# --- deadlines (the jury waits 300 s from the start of the upload) ---
JOB_HARD_LIMIT_SEC=270        # soft deadline passed to the pipeline, counted from the start of the upload
WATCHDOG_GRACE_SEC=8          # after soft deadline + grace the worker is killed and a partial result is returned
WORKER_STALL_SEC=150          # no progress for this long -> worker killed, partial result returned
ON_DEADLINE=partial           # partial — done with what was found so far; failed — status=failed
ON_FAILURE=partial            # analyzer exception after retries: partial | failed
MAX_ATTEMPTS=2                # crash / exception -> one retry if there is still time
RETRY_ON_ERROR=1

# --- live mode ---
LIVE_FPS=4                    # frames per second analyzed per camera / browser session
LIVE_FPS_BUSY=1               # ...while jury/UI jobs are being processed
LIVE_MAX_SIDE=640
CAMERA_RECONNECT_SEC=5

# --- alerts (all optional; policy in backend/alerts.yaml) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_OPERATOR=       # chat id for operators
TELEGRAM_CHAT_SUPERVISOR=     # chat id for supervisors / security
ALERT_WEBHOOK_URL=            # SIEM / SOC endpoint, JSON POST signed with X-Signature (HMAC-SHA256)
ALERT_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_OPERATOR=
ALERT_EMAIL_SUPERVISOR=

# --- model (read by ml/) ---
SAMPLE_FPS=2
DETECTOR_MODEL=PekingU/rtdetr_r18vd
DETECTOR_DEVICE=auto          # auto|cuda|mps|cpu
DET_SCORE=0.45
VLM_BACKEND=ollama            # ollama | openai | none
VLM_URL=http://127.0.0.1:11434
VLM_MODEL=qwen2.5vl:7b
VLM_TIMEOUT=60
VLM_IMAGE_SIDE=448
VLM_FRAMES_PER_CALL=5
VLM_WINDOW_SEC=6
MAX_VLM_CALLS=12
MIN_CONFIDENCE=0.5
MERGE_SEC=5
TIME_BUDGET_SEC=120
SCREEN_ON_V=140
# HF_HUB_OFFLINE=1            # enable once the weights are downloaded
