# Team config (private repo). Used by deploy/run_server.* and by docker compose (deploy/DOCKER.md).
# Keep comments on their own lines: docker compose reads `KEY=   # text` as the value "# text".
# Native run on a Mac: ANALYZER=mock below. Docker GPU stack (deploy/docker.ps1) switches to the real model by itself.

# --- service ---
# mock — no model (Mac); ml — real pipeline (ROG); module:function — custom
ANALYZER=mock
# process — analyzer in an isolated child process (recommended); thread — in-process
WORKER_MODE=process
# one GPU -> one worker (each worker loads the models)
WORKERS=1
# load detector / ping VLM in the worker at start
WARMUP=1
# jury key; empty = generated once into storage/api_key.txt
API_KEY=cg-jury-ocBMhhS8gagZDu0cqcbohAKq
# admin key (cameras, keys, config); empty = same as API_KEY
ADMIN_KEY=cg-admin-y4UQCtMJIf0CUXdqNVEpHG--
# 1 — the web UI endpoints also require a key
UI_REQUIRE_KEY=0
# uploads per minute per key / IP
RATE_LIMIT_PER_MIN=60
MAX_UPLOAD_MB=200
# uploaded videos and clips are deleted this long after the job finishes
VIDEO_TTL_SEC=3600
# 0 = keep results (JSON with frames) forever
RESULT_TTL_SEC=0
# identical file (SHA-256) + same analyzer -> instant result
DEDUP=1
# cut a 10-second mp4 around every violation (needs ffmpeg on PATH)
MAKE_CLIPS=1
CORS_ORIGINS=*
# e.g. https://xxx.trycloudflare.com — used in alert links
PUBLIC_URL=
LOG_LEVEL=INFO
LOG_JSON=0
MOCK_DELAY=3

# --- deadlines (the jury waits 300 s from the start of the upload) ---
# soft deadline passed to the pipeline, counted from the start of the upload
JOB_HARD_LIMIT_SEC=270
# after soft deadline + grace the worker is killed and a partial result is returned
WATCHDOG_GRACE_SEC=8
# no progress for this long -> worker killed, partial result returned
WORKER_STALL_SEC=150
# partial — done with what was found so far; failed — status=failed
ON_DEADLINE=partial
# analyzer exception after retries: partial | failed
ON_FAILURE=partial
# crash / exception -> one retry if there is still time
MAX_ATTEMPTS=2
RETRY_ON_ERROR=1

# --- live mode ---
# frames per second analyzed per camera / browser session
LIVE_FPS=4
# ...while jury/UI jobs are being processed
LIVE_FPS_BUSY=1
LIVE_MAX_SIDE=640
CAMERA_RECONNECT_SEC=5

# --- alerts (all optional; policy in backend/alerts.yaml) ---
TELEGRAM_BOT_TOKEN=
# chat id for operators
TELEGRAM_CHAT_OPERATOR=
# chat id for supervisors / security
TELEGRAM_CHAT_SUPERVISOR=
# SIEM / SOC endpoint, JSON POST signed with X-Signature (HMAC-SHA256)
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_OPERATOR=
ALERT_EMAIL_SUPERVISOR=

# --- model (read by ml/) ---
SAMPLE_FPS=2
DETECTOR_MODEL=PekingU/rtdetr_r18vd
# auto|cuda|mps|cpu
DETECTOR_DEVICE=auto
DET_SCORE=0.45
# ollama | openai | none
VLM_BACKEND=ollama
VLM_URL=http://127.0.0.1:11434
# Qwen3.5-4B (Apache-2.0, ~3.3 ГБ): ollama pull qwen3.5:4b
VLM_MODEL=qwen3.5:4b
VLM_TIMEOUT=60
VLM_IMAGE_SIDE=448
VLM_FRAMES_PER_CALL=5
VLM_WINDOW_SEC=6
MAX_VLM_CALLS=12
MIN_CONFIDENCE=0.5
MERGE_SEC=5
TIME_BUDGET_SEC=120
SCREEN_ON_V=140
# enable once the weights are downloaded
# HF_HUB_OFFLINE=1

# --- docker (docker-compose.yml / docker-compose.gpu.yml, see deploy/DOCKER.md) ---
# host port of the web UI and API
PORT=8000
# analyzer inside the container: empty = mock for docker-compose.yml, ml with docker-compose.gpu.yml
ANALYZER_DOCKER=
# VLM for the GPU stack: empty = the bundled ollama service; http://host.docker.internal:11434 = Ollama on the host
VLM_URL_DOCKER=
# named Cloudflare tunnel (profile tunnel-named); empty = use the quick tunnel (profile tunnel)
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoiMDJkNGQwMjkyMmIyY2Q2M2Y0NjMwZGRhYjNlZTMzMzYiLCJ0IjoiZjEzNmNmMGMtYjc4Mi00NTlmLThlZmQtNDEyMGE5NjFiMGUxIiwicyI6Ik5UZGhNRFV5TjJFdE9XSTFZUzAwWXpabExUbGxZalF0WlRVMU5qRTJaRE01WW1WayJ9
